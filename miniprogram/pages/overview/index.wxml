<import src="../../components/connection.wxml" />
<view class="page overview-page">
  <view class="brand-row"><view class="brand"><view class="brand-symbol">≋</view><text>澜枢</text><text class="brand-english">LANSHU</text></view><view class="simulation-badge">本地模拟</view></view>
  <view class="greeting">{{greeting}}</view>
  <template is="connection" data="{{state, loading, error}}" />
  <block wx:if="{{state}}">
    <view class="farm-hero">
      <view class="hero-orbit orbit-one"></view><view class="hero-orbit orbit-two"></view>
      <view class="row hero-content"><view><view class="hero-location">{{state.farm.location}}</view><view class="hero-title">{{state.farm.name}}</view></view><view class="hero-status"><view class="hero-status-dot"></view>{{error ? '连接中断' : '实时同步'}}</view></view>
      <view class="hero-water hero-content"><text class="hero-water-label">今日累计用水</text><view class="hero-water-value">{{state.todayWater}}<text class="hero-unit">m³</text></view></view>
      <view class="hero-footer hero-content"><text>{{state.farm.area}} 亩 · {{state.zones.length}} 个灌溉分区</text><text bindtap="openIrrigation">进入田间 →</text></view>
    </view>
    <view class="weather-strip" wx:if="{{state.weather}}"><view class="weather-sun">☀</view><view class="weather-main"><text class="weather-temperature">{{state.weather.temperature}}°</text><text>{{state.weather.description}}</text></view><view class="weather-detail">湿度 {{state.weather.humidity}}%<text>降雨概率 {{state.weather.rainProbability}}%</text></view></view>
    <view class="metric-grid">
      <view class="metric-item"><view class="metric-top"><text>平均土壤含水率</text><text class="metric-icon">◉</text></view><view class="metric-value">{{state.avgMoisture}}<text>%</text></view><view class="metric-note">{{state.dryCount}} 个分区低于目标</view></view>
      <view class="metric-item" bindtap="openIrrigation"><view class="metric-top"><text>正在灌溉</text><text class="metric-icon">≋</text></view><view class="metric-value">{{state.wateringCount}}<text>/ {{state.zones.length}}</text></view><view class="metric-note">查看分区运行状态 →</view></view>
      <view class="metric-item" bindtap="openConnectionSettings"><view class="metric-top"><text>在线设备</text><text class="metric-icon">⌁</text></view><view class="metric-value">{{state.onlineCount}}<text>/ {{state.devices.length}}</text></view><view class="metric-note">设备通信状态</view></view>
      <view class="metric-item" bindtap="openAlerts"><view class="metric-top"><text>待处理告警</text><text class="metric-icon alert-icon">!</text></view><view class="metric-value {{state.unreadCount ? 'attention-value' : ''}}">{{state.unreadCount}}<text>条</text></view><view class="metric-note">{{state.unreadCount ? '有事项需要关注 →' : '当前无待处理事项'}}</view></view>
    </view>
    <view class="section-heading"><text class="section-title">灌溉，从容安排</text><text class="section-link" bindtap="openPlans">查看计划 →</text></view>
    <view class="quick-panel"><view class="quick-cell" bindtap="openIrrigation"><view class="quick-icon">≋</view><view><view class="quick-title">手动灌溉</view><view class="caption">按需开启，精准补水</view></view><text class="quick-arrow">›</text></view><view class="quick-cell" bindtap="openPlans"><view class="quick-icon light">◷</view><view><view class="quick-title">定时计划</view><view class="caption">{{state.enabledPlanCount}} 项计划已启用</view></view><text class="quick-arrow">›</text></view></view>
    <view class="section-heading"><text class="section-title">用水趋势</text><text class="caption">最近 {{state.chartHistory.length}} 天 · m³</text></view>
    <view class="panel chart-panel" wx:if="{{state.chartHistory.length}}"><view class="chart"><view class="chart-column" wx:for="{{state.chartHistory}}" wx:key="date"><view class="chart-value">{{item.waterText}}</view><view class="chart-bar-track"><view class="chart-bar {{index === state.chartHistory.length - 1 ? 'latest' : ''}}" style="height:{{item.height}};"></view></view><view class="chart-label">{{item.dateLabel}}</view></view></view></view>
    <view class="empty" wx:else>暂无用水历史记录</view>
    <view class="section-heading"><text class="section-title">田间动态</text><text class="caption">最近 5 条</text></view>
    <view class="panel activity-panel" wx:if="{{state.recentLogs.length}}"><view class="activity-item" wx:for="{{state.recentLogs}}" wx:key="id"><view class="activity-marker"></view><view class="activity-content"><view>{{item.message}}</view><view class="caption">{{item.timeText}}</view></view></view></view>
    <view class="empty" wx:else>田间动态将在这里显示</view>
    <view class="sync-line">{{error ? '上次同步' : '数据更新'}} {{state.updatedText}} · 模拟设备数据</view>
  </block>
</view>
