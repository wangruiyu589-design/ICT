<import src="../../components/connection.wxml" />
<view class="page">
  <view class="workspace-profile"><view class="workspace-avatar">澜</view><view><view class="workspace-name">{{state ? state.farm.name : '澜枢智慧灌溉'}}</view><view class="workspace-subtitle">本地工作空间 <text>LANSHU</text></view></view></view>
  <template is="connection" data="{{state, loading, error}}" />
  <view class="workspace-note"><view class="simulation-badge">SIMULATION</view><text>本地模拟模式 · 与网页端共享数据</text></view>
  <view class="section-heading"><view class="section-title">服务连接</view><view class="tag {{state && !error ? 'tag-green' : 'tag-orange'}}">{{state && !error ? '已连接' : '待连接'}}</view></view>
  <view class="panel connection-panel"><view class="field-label">API 服务地址</view><input class="field-input url-input" type="text" value="{{urlInput}}" bindinput="changeUrl" placeholder="http://192.168.1.20:8787" maxlength="180" /><view class="field-hint">开发者工具使用 127.0.0.1；手机调试填写电脑的局域网 IP。地址设置只保存在本机。</view><view wx:if="{{connectionError}}" class="form-error">{{connectionError}}</view><button class="primary-button" bindtap="saveConnection" loading="{{busy === 'connect'}}" disabled="{{busy}}">保存并连接</button><view class="connection-tools"><text bindtap="resetUrl">填入默认地址</text><text bindtap="copyAddress">复制当前地址</text></view></view>
  <block wx:if="{{state}}">
    <view class="section-heading"><view class="section-title">农场信息</view><view class="caption">与网页端同步</view></view>
    <view class="panel info-panel"><view class="info-row"><text>农场名称</text><view>{{state.farm.name}}</view></view><view class="info-row"><text>所在地区</text><view>{{state.farm.location}}</view></view><view class="info-row"><text>管理面积</text><view>{{state.farm.area}} 亩</view></view><view class="info-row"><text>灌溉分区</text><view>{{state.zones.length}} 个</view></view><view class="info-row"><text>单次灌溉上限</text><view>{{state.settings.maxDuration}} 分钟</view></view></view>
    <view class="section-heading"><view class="section-title">设备状态</view><text class="section-link" bindtap="toggleDevices">{{showDevices ? '收起' : '展开'}} {{state.devices.length}} 台设备 {{showDevices ? '↑' : '↓'}}</text></view>
    <view class="device-summary"><view><view class="device-number">{{state.onlineCount}}</view><text>在线设备</text></view><view><view class="device-number offline-number">{{state.devices.length - state.onlineCount}}</view><text>离线设备</text></view><view><view class="device-number">{{state.devices.length}}</view><text>设备总数</text></view></view>
    <view class="panel devices-panel" wx:if="{{showDevices}}"><view class="device-item" wx:for="{{state.devices}}" wx:key="id"><view class="row"><view class="device-name">{{item.name}}</view><view class="tag {{item.status === 'online' ? 'tag-green' : ''}}">{{item.statusText}}</view></view><view class="device-meta">{{item.zoneName}} · {{item.type}}</view><view class="device-detail"><text>电量 {{item.battery}}%</text><text>信号 {{item.signal}}%</text></view><view class="caption">最近通信 {{item.lastSeenText}}</view></view><view wx:if="{{!state.devices.length}}" class="muted small">暂无设备</view></view>
  </block>
  <view class="section-heading"><view class="section-title">本地联调提示</view></view>
  <view class="panel help-panel"><view class="help-item"><view class="help-number">01</view><view><view class="help-title">先启动电脑上的服务</view><view class="help-copy">保持 API 服务运行。网页端和小程序需连接同一服务地址，数据变更会相互同步。</view></view></view><view class="help-item"><view class="help-number">02</view><view><view class="help-title">在微信开发者工具中预览</view><view class="help-copy">导入 miniprogram 目录。开发阶段需关闭合法域名、TLS 版本及 HTTPS 证书校验。</view></view></view><view class="help-item"><view class="help-number">03</view><view><view class="help-title">手机与电脑连接同一 Wi-Fi</view><view class="help-copy">真机调试需要使用自己的小程序 AppID。后端设置 HOST=0.0.0.0，并允许防火墙访问 8787 端口。</view></view></view></view>
  <view class="about-brand">LANSHU<view>澜枢 · 看见水，读懂田</view><text>本地开发版本 1.0.0</text></view>
</view>
