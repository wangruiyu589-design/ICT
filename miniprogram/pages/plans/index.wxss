.page-title{font-size:38rpx}.schedule-banner{display:flex;align-items:center;gap:20rpx;background:#e9f1ff;padding:23rpx;border-radius:20rpx;margin-bottom:26rpx}.schedule-symbol{font-size:49rpx;color:#548add;line-height:1}.schedule-heading{color:#3e6fae;font-size:26rpx;font-weight:600;margin-bottom:5rpx}.schedule-banner .caption{font-size:19rpx;color:#7d96bb}.plan-title{font-size:28rpx;font-weight:600;max-width:470rpx}.plan-time-row{display:flex;align-items:baseline;gap:20rpx;margin-top:20rpx}.plan-time{font-size:62rpx;font-weight:550;color:#2c517f;letter-spacing:-2rpx;line-height:1.3}.plan-duration{font-size:22rpx;color:#99a5b6}.plan-days{font-size:23rpx;color:#6890bf;margin-top:10rpx}.plan-zones{font-size:22rpx;color:#93a0b3;margin-top:12rpx;line-height:1.7}.plan-actions{border-top:1rpx solid #edf1f6;margin-top:24rpx;padding-top:22rpx;display:flex;justify-content:space-between;align-items:center}.delete-plan{color:#a5aebd}.plan-toggle{background:#eaf2ff;color:#2770d7;border-radius:10rpx;padding:12rpx 23rpx;font-size:22rpx}.pause-plan{background:#f1f4f8;color:#7d8fa4}.empty-action{margin:25rpx auto 0;background:#eaf2ff;color:#246de1;font-size:24rpx;display:inline-block;padding:18rpx 26rpx;border-radius:12rpx}.sheet-body{height:61vh}
