<import src="../../components/connection.wxml" />
<view class="page">
  <view class="eyebrow">IRRIGATION CONTROL</view><view class="page-heading"><view><view class="page-title">把水送到需要的地方</view><view class="page-subtitle">每个分区，都在掌握之中</view></view></view>
  <template is="connection" data="{{state, loading, error}}" />
  <block wx:if="{{state}}">
    <view class="control-summary"><view><view class="control-count">{{state.wateringCount}}<text>个分区正在灌溉</text></view><view class="caption">{{state.zones.length}} 个分区 · {{state.dryCount}} 个低于目标含水率</view></view><button class="stop-all" bindtap="stopAll" loading="{{busy === 'stop-all'}}" disabled="{{!state.wateringCount || busy || error}}">全部停止</button></view>
    <view class="filter-row"><view class="filter-item {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="chooseFilter">全部</view><view class="filter-item {{filter === 'watering' ? 'active' : ''}}" data-filter="watering" bindtap="chooseFilter">灌溉中</view><view class="filter-item {{filter === 'dry' ? 'active' : ''}}" data-filter="dry" bindtap="chooseFilter">待补水</view><view class="filter-item {{filter === 'offline' ? 'active' : ''}}" data-filter="offline" bindtap="chooseFilter">离线</view></view>
    <view wx:for="{{visibleZones}}" wx:key="id" class="panel zone-panel {{item.status === 'watering' ? 'zone-active' : ''}}">
      <view class="row"><view><view class="zone-name">{{item.name}}</view><view class="zone-meta">{{item.crop}} · {{item.area}} 亩</view></view><view class="tag {{item.status === 'watering' ? 'tag-blue' : item.status === 'offline' ? '' : 'tag-green'}}"><view class="dot"></view>{{item.statusText}}</view></view>
      <view class="moisture-row"><view><text class="moisture-value">{{item.moistureText}}</text><text class="moisture-unit">%</text><text class="moisture-label">土壤含水率</text></view><text class="moisture-target">目标 {{item.targetText}}%</text></view>
      <view class="moisture-track"><view class="moisture-fill {{item.needsWater ? 'low-moisture' : ''}}" style="width:{{item.moistureWidth}}"></view></view>
      <view class="zone-readings"><view><text>流量</text><view>{{item.flowText}}<text> L/min</text></view></view><view><text>压力</text><view>{{item.pressureText}}<text> MPa</text></view></view><view><text>电量</text><view>{{item.batteryText}}<text>%</text></view></view></view>
      <button wx:if="{{item.status === 'watering'}}" class="secondary-button" data-id="{{item.id}}" bindtap="stopWatering" loading="{{busy === item.id}}" disabled="{{busy || error}}">停止本次灌溉</button>
      <button wx:elif="{{item.status === 'idle'}}" class="primary-button" data-id="{{item.id}}" bindtap="openStart" disabled="{{busy || error}}">开启灌溉</button>
      <view wx:else class="offline-tip">设备离线，暂时无法控制<text>最后通信 {{item.lastSeenText}}</text></view>
    </view>
    <view wx:if="{{!visibleZones.length}}" class="empty"><view class="empty-title">当前分类没有分区</view><view>可切换其他分类查看田间状态</view></view>
    <view class="sync-line">每 15 秒同步 · {{state.updatedText}} · 本地模拟</view>
  </block>
</view>
<view wx:if="{{sheetOpen}}" class="modal-backdrop" catchtap="closeSheet"><view class="sheet" catchtap="noop"><view class="sheet-header"><view class="sheet-title">开启灌溉</view><view class="sheet-close" bindtap="closeSheet">×</view></view><view class="sheet-body"><view class="start-zone"><view class="zone-name">{{selectedZone.name}}</view><view class="caption">{{selectedZone.crop}} · 当前含水率 {{selectedZone.moistureText}}%</view></view><view class="field"><text class="field-label">灌溉时长</text><view class="field-input field-input-inline"><input type="number" value="{{duration}}" bindinput="changeDuration" maxlength="3" /><text class="muted">分钟</text></view><view class="duration-options"><view wx:for="{{durationOptions}}" wx:key="*this" class="duration-option {{duration == item ? 'selected' : ''}}" data-value="{{item}}" bindtap="quickDuration">{{item}} 分钟</view></view><view class="field-hint">允许 1～{{state.settings.maxDuration || 120}} 分钟，到时自动停止。</view></view><view wx:if="{{formError}}" class="form-error">{{formError}}</view><view class="form-note">当前使用本地模拟设备。网页端与小程序共享同一套灌溉状态。</view></view><view class="sheet-footer"><button class="secondary-button" bindtap="closeSheet" disabled="{{busy}}">取消</button><button class="primary-button" bindtap="startWatering" loading="{{busy === selectedZone.id}}" disabled="{{busy || error}}">确认开启</button></view></view></view>
