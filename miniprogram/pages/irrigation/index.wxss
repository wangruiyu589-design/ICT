ons{display:flex;gap:12rpx;margin-top:18rpx}.duration-option{flex:1;background:#f2f5fa;color:#8999ad;text-align:center;font-size:22rpx;padding:16rpx 0;border-radius:12rpx}.duration-option.selected{background:#e7efff;color:#246ce0}
