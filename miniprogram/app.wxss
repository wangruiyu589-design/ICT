page{background:#f4f7fb;color:#172c48;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:26rpx;line-height:1.5;box-sizing:border-box}
view,text,button,input,textarea{box-sizing:border-box}button{margin:0;font-size:26rpx;line-height:1.4}button::after{border:0}button[disabled]{opacity:.48}button:active{opacity:.8}
.page{padding:24rpx 32rpx 48rpx}.eyebrow{font-size:19rpx;color:#8493a8;letter-spacing:3rpx;font-weight:600}.page-heading{display:flex;align-items:center;justify-content:space-between;margin:12rpx 0 28rpx}.page-title{font-size:44rpx;line-height:1.2;letter-spacing:-1rpx;font-weight:700}.page-subtitle{color:#8794a8;font-size:23rpx;margin-top:12rpx}.heading-action{background:#1662e8;color:#fff;border-radius:16rpx;padding:18rpx 24rpx;font-weight:600;white-space:nowrap}
.section-heading{display:flex;align-items:center;justify-content:space-between;margin:36rpx 0 20rpx}.section-title{font-size:29rpx;font-weight:700}.section-link{font-size:22rpx;color:#226be0}.panel{background:#fff;border:1rpx solid #e7edf5;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx}.row{display:flex;align-items:center;justify-content:space-between}.muted{color:#8b98ac}.small{font-size:22rpx}.caption{font-size:20rpx;color:#8895a8}.tag{font-size:19rpx;font-weight:500;padding:5rpx 14rpx;border-radius:8rpx;background:#f0f4fa;color:#77869b;white-space:nowrap}.tag-blue{background:#edf4ff;color:#2068db}.tag-green{background:#eaf8f4;color:#269378}.tag-orange{background:#fff4e5;color:#b97621}.tag-red{background:#fff0f0;color:#d26066}.dot{width:10rpx;height:10rpx;border-radius:50%;background:currentColor;display:inline-block;margin-right:8rpx}
.primary-button{padding:22rpx 28rpx;background:#1662e8;border-radius:14rpx;color:#fff;font-weight:600;text-align:center}.secondary-button{padding:20rpx 26rpx;background:#eef4fe;border-radius:14rpx;color:#2469d1;font-weight:600;text-align:center}.danger-button{padding:20rpx 26rpx;background:#fff1f1;border-radius:14rpx;color:#c8545e;font-weight:600;text-align:center}.text-button{background:transparent;color:#7e8c9f;padding:0;display:inline-block;font-size:22rpx;line-height:1.5}.empty{padding:60rpx 28rpx;text-align:center;color:#8b99ac;background:#fff;border:1rpx solid #e7edf5;border-radius:24rpx}.empty-title{font-size:29rpx;font-weight:600;color:#465a76;margin-bottom:10rpx}.sync-line{font-size:20rpx;color:#98a5b5;text-align:center;margin-top:28rpx}.simulation-badge{background:#e8f0fc;color:#6183b6;border-radius:8rpx;padding:5rpx 12rpx;font-size:18rpx;display:inline-block}
.connection-error{background:#fff5e7;border:1rpx solid #f1dfc0;padding:24rpx;border-radius:18rpx;margin-bottom:24rpx;color:#876129}.connection-title{font-weight:600;font-size:25rpx}.connection-copy{font-size:22rpx;margin-top:10rpx;line-height:1.6}.connection-actions{display:flex;justify-content:space-between;margin-top:18rpx;font-size:23rpx;color:#8c672f;font-weight:600}.loading-panel{padding:100rpx 24rpx;display:flex;justify-content:center;align-items:center;gap:20rpx;color:#8794a8}.loading-dot{width:20rpx;height:20rpx;border-radius:50%;background:#216aec;animation:pulse 1s ease-in-out infinite}@keyframes pulse{50%{opacity:.25}}
.filter-row{display:flex;gap:12rpx;margin-bottom:24rpx}.filter-item{padding:14rpx 22rpx;color:#7b8ba0;background:#eaf0f7;font-size:23rpx;border-radius:12rpx}.filter-item.active{background:#e2edff;color:#1763df;font-weight:600}
.modal-backdrop{position:fixed;inset:0;background:rgba(18,39,70,.34);z-index:100;display:flex;align-items:flex-end}.sheet{width:100%;max-height:90vh;background:#fff;border-radius:32rpx 32rpx 0 0;overflow:hidden;padding-bottom:env(safe-area-inset-bottom)}.sheet-header{display:flex;align-items:center;justify-content:space-between;padding:32rpx;border-bottom:1rpx solid #eef2f7}.sheet-title{font-size:32rpx;font-weight:700}.sheet-close{font-size:42rpx;color:#8391a4;line-height:1;width:48rpx;text-align:right}.sheet-body{padding:28rpx 32rpx;max-height:61vh;box-sizing:border-box}.sheet-footer{display:flex;gap:18rpx;padding:24rpx 32rpx;border-top:1rpx solid #eef2f7}.sheet-footer button{flex:1}.field{margin-bottom:28rpx}.field-label{font-weight:600;font-size:25rpx;margin-bottom:14rpx;display:block}.field-hint{color:#8d9aad;font-size:21rpx;margin-top:10rpx;line-height:1.6}.field-input{background:#f5f7fb;border:1rpx solid #e4eaf3;border-radius:14rpx;padding:20rpx 22rpx;min-height:82rpx;width:100%;font-size:27rpx}.field-input-inline{display:flex;align-items:center;justify-content:space-between}.field-input-inline input{flex:1}.form-error{color:#c85361;background:#fff1f2;border-radius:12rpx;padding:16rpx 20rpx;margin-bottom:20rpx;font-size:23rpx}.check-option{display:flex;align-items:center;gap:16rpx;padding:18rpx 0;border-bottom:1rpx solid #f0f3f8}.check-option checkbox{transform:scale(.85)}.check-option-name{font-size:25rpx}.check-option-note{font-size:21rpx;color:#8998ac}.day-options{display:flex;justify-content:space-between;gap:8rpx}.day-option{flex:1;text-align:center;padding:16rpx 0;border-radius:12rpx;background:#f1f5fa;color:#7d8da2;font-size:23rpx}.day-option.selected{background:#e8f0ff;color:#1662e8;font-weight:600}.form-note{padding:18rpx 20rpx;background:#eff5fe;color:#6481ad;font-size:22rpx;border-radius:12rpx;line-height:1.7}
